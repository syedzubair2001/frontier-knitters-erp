# Copy this file as .env and adjust for YOUR PC.
# SQL Server connection — default works with SQL Server Express + Windows Auth.

# Server name as shown in SSMS connect box (e.g. localhost, .\SQLEXPRESS, YOUR-PC\SQLEXPRESS)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=FrontierERP
# TRUSTED=yes  -> Windows Authentication (SSMS default login). Leave yes.
# TRUSTED=no   -> SQL login: also fill DB_USER / DB_PASSWORD
DB_TRUSTED=yes
DB_USER=sa
DB_PASSWORD=

# ODBC driver installed with SQL Server / SSMS. Try 17 first, then 18 if error.
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Security — change this secret to any long random text before real use!
JWT_SECRET=change-this-to-a-long-random-secret-string-2026
JWT_HOURS=12

# Comma-separated origins allowed to call this API.
# Keep * while testing; later put your Vercel URL.
CORS_ORIGINS=*
